# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# Vault definitions. `swamp vault create --config` persists whatever it is
# given verbatim, and marking a field `sensitive` governs logging, not what
# lands on disk — so a literal token passed on the command line becomes a live
# credential in a tracked file. This repository is public. Never commit a vault
# definition; wire secrets as vault references and keep the file out of git.
vaults/

# Restore-drill scratch targets. A drill writes real restored file content to
# disk; that content is production data and must never reach git.
restore-drills/

# Model definitions. Unlike the B2 suite, every instance here is named after a
# real host and carries that host's real bucket name — 18 instances would
# publish the complete fleet inventory. The README documents the shape with
# fictional names instead.
/models/
